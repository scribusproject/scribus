#include <windows.h>

#include "ads_version.h"

#define ADS_MAKE_VERSION_STR_REAL(M,m,p) M ## . ## m ## . ## p
#define ADS_STR(x) #x "\0"
#define ADS_XSTR(x) ADS_STR(x)
#define ADS_MAKE_VERSION_STR(M,m,p) ADS_XSTR(ADS_MAKE_VERSION_STR_REAL(M,m,p))
#define ADS_VERSION_STRING ADS_MAKE_VERSION_STR(ADS_VERSION_MAJOR, ADS_VERSION_MINOR, ADS_VERSION_PATCH)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     ADS_VERSION_MAJOR, ADS_VERSION_MINOR, ADS_VERSION_PATCH,0
 PRODUCTVERSION  ADS_VERSION_MAJOR, ADS_VERSION_MINOR, ADS_VERSION_PATCH,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS       VS_FF_DEBUG
#else
 FILEFLAGS       0
#endif
 FILEOS          VOS__WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "N/A\0"
            VALUE "ProductName",      "QtADS\0"
            VALUE "FileDescription",  "QtADS\0"
            VALUE "FileVersion",      ADS_VERSION_STRING
            VALUE "ProductVersion",   ADS_VERSION_STRING
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
